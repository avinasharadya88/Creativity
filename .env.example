# Server Port (AI Studio uses 3000)
PORT=3000
# BIND_HOST is optional. The app defaults to 0.0.0.0 so Cloud Run can reach it.
# Do not use HOST; Google AI Studio reserves it for an application label.
# BIND_HOST=127.0.0.1
# Required to enable POST /api/routes. Use a long, random value.
API_WRITE_TOKEN=replace-with-a-random-secret
# Optional override. If omitted, the server reads metadata.json.
# AIRAC_CYCLE=2609
# Optional durable storage locations. Defaults are under .data/.
# ROUTE_DATA_FILE=.data/routes.json
# AUDIT_LOG_FILE=.data/audit.jsonl
# ROUTE_HISTORY_DIR=.data/history
# Optional comma-separated browser origins allowed to call the API cross-origin.
CORS_ORIGINS=

{
  "name": "enasr-arinc424-mtr-explorer",
  "version": "1.0.0",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "gcp-build": "npm run build",
    "lint": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "verify:data": "node scripts/verify-data.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

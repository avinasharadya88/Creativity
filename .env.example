# Server Port (AI Studio uses 3000)
PORT=3000
# Bind locally by default. Set to 0.0.0.0 only behind an authenticated proxy.
HOST=127.0.0.1
# Required to enable POST /api/routes. Use a long, random value.
API_WRITE_TOKEN=replace-with-a-random-secret
# Optional comma-separated browser origins allowed to call the API cross-origin.
CORS_ORIGINS=
